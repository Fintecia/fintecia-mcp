{
  "name": "fintecia",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP local de Fintecia — descarga de CFDI con e-firma, conciliación banco-CFDI, riesgo 69-B/EFOS, deducibilidad fiscal. SAT · CFDI · Conciliación · Seguridad · México · agente AI",
  "license": "MIT",
  "author": "Fintecia (https://fintecia.com.mx)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fintecia/fintecia-mcp.git"
  },
  "homepage": "https://fintecia.com.mx",
  "bugs": {
    "url": "https://github.com/Fintecia/fintecia-mcp/issues"
  },
  "keywords": [
    "mcp",
    "sat",
    "cfdi",
    "efirma",
    "mexico",
    "finanzas",
    "contabilidad",
    "impuestos",
    "agente-ai"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "fintecia-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:smoke": "tsx test/smoke/fiel.smoke.ts && tsx test/smoke/onboard.smoke.ts && tsx test/smoke/descarga.smoke.ts && tsx test/smoke/handlers.smoke.ts",
    "onboard": "tsx src/onboard/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "@nodecfdi/sat-ws-descarga-masiva": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
